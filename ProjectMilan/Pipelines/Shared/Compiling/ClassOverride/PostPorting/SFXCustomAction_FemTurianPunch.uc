// Source: LE3, TurianFemale_Vanguard_MP
// Initial decompilation: 9/7/2024 5:13:48 PM
// MILAN CHANGE - UP3 - Teleport uses inherited effect instead of nothing
Class SFXCustomAction_FemTurianPunch extends SFXCustomAction_FemTeleportPunchBase
    config(Game);

var BodyStance BS_AnimEnd;
var WwiseEvent BladeImpact;
var ParticleSystem PS_BloodImpactTemplate;
var ParticleSystem PS_BladeImpactTemplate;
var RvrClientEffectInterface CE_PoisonImpactTemplate;
var config float TurDamageReductionLength;
var config float TurDamageReductionAmount;
var bool bSecondPhase;
var config bool bAllowTurDamageReduction;

public function bool OnActorImpacted(EPowerResistance Resistance, Actor oImpacted, int nPreviouslyImpacted, Vector HitLocation, Vector HitNormal)
{
    local BioPawn oPawn;
    local SFXObjectPool Pool;
    local SFXEmitter oEmitter;
    local float fBloodScale;
    local SFXModule_GameEffectManager Manager;
    local SFXGameEffect_DamageOverTime Effect;
    local SFXPowerCustomActionMP_FemTurianMeleePassive FemTurianPower;
    local RvrClientEffectTarget TargetInfo;
    
    Super(SFXCustomAction_PlayerHeavyMeleeBase).OnActorImpacted(Resistance, oImpacted, nPreviouslyImpacted, HitLocation, HitNormal);
    if (Power == None)
    {
        return FALSE;
    }
    oPawn = BioPawn(oImpacted);
    if (oPawn == None)
    {
        return FALSE;
    }
    m_oPawn.PlaySound(BladeImpact, TRUE);
    Pool = SFXGRI(m_oPawn.WorldInfo.GRI).ObjectPool;
    if (Pool == None)
    {
        return FALSE;
    }
    oEmitter = Pool.GetImpactEmitter(PS_BladeImpactTemplate, HitLocation, Rotator(HitNormal));
    if (oEmitter != None)
    {
        oEmitter.ParticleSystemComponent.SetActive(TRUE);
    }
    if (oPawn.GetAimNodeLocation(1, HitLocation))
    {
        fBloodScale = 1.0;
        if (oPawn.IsDead())
        {
            oPawn.GibHead(HitLocation, HitNormal, 'Head', DamageType);
            fBloodScale = 2.5;
        }
        oEmitter = Pool.GetImpactEmitter(PS_BloodImpactTemplate, HitLocation, Rotator(HitNormal));
        if (oEmitter != None)
        {
            Pool.ApplyBloodColor(oEmitter.ParticleSystemComponent, oPawn);
            oEmitter.ParticleSystemComponent.SetScale(fBloodScale);
            oEmitter.ParticleSystemComponent.SetActive(TRUE);
        }
    }
    if (oPawn.IsDead())
    {
        Power.OnHeavyMeleeKill(oImpacted);
    }
    if (Resistance != EPowerResistance.Resistance_Full)
    {
        Manager = oImpacted.GetModule(Class'SFXModule_GameEffectManager');
        FemTurianPower = SFXPowerCustomActionMP_FemTurianMeleePassive(Power);
        if (Manager != None)
        {
            Effect = SFXGameEffect_DamageOverTime(Manager.CreateEffect(Class'SFXGameEffect_DamageOverTime', 'TurianMeleePoisonDamage', FemTurianPower.PoisonDamageDuration, 1, FemTurianPower.HeavyMeleeDamage.CurrentValue * FemTurianPower.PoisonDamage / FemTurianPower.PoisonDamageDuration, m_oPawn.Controller));
            if (Effect != None)
            {
                TargetInfo.Instigator = oImpacted;
                TargetInfo.SpawnValue.X = FemTurianPower.PoisonDamageDuration;
                Class'RvrClientEffectManager'.static.GetClientEffectManager().PlayOnTarget(CE_PoisonImpactTemplate, TargetInfo);
                Effect.DamageType = DamageType;
                Effect.OnApplied();
            }
        }
    }
    return TRUE;
}
public function StartCustomAction()
{
    local SFXModule_GameEffectManager GEManager;
    
    bSecondPhase = FALSE;
    Super.StartCustomAction();
    if (bAllowTurDamageReduction)
    {
        GEManager = m_oPawn.GetModule(Class'SFXModule_GameEffectManager');
        if (GEManager != None)
        {
            GEManager.CreateAndApplyEffect(Class'SFXGameEffect_DamageTakenBonus', 'TurDamageReduction', TurDamageReductionLength, 1, -TurDamageReductionAmount, m_oPawn.Controller);
        }
    }
}
public function BodyStanceAnimEndNotification(AnimNodeSequence SeqNode, float PlayedTime, float ExcessTime)
{
    if (!bSecondPhase)
    {
        bSecondPhase = TRUE;
        if (m_oPawn.PlayBodyStance(BS_AnimEnd, 1.0, fAnimBlendInTime, fAnimBlendOutTime) != 0.0)
        {
            m_oPawn.SetBodyStanceAnimEndNotification(BS_AnimEnd, TRUE);
        }
    }
    else
    {
        Super(SFXCustomAction_SingleAnim).BodyStanceAnimEndNotification(SeqNode, PlayedTime, ExcessTime);
    }
}
public function BodyStance GetBodyStanceAnim()
{
    if (!bSecondPhase)
    {
        return BS_Anim;
    }
    else
    {
        return BS_AnimEnd;
    }
}
public function MeleeImpact()
{
    local SFXPowerCustomActionMP_FemTurianMeleePassive FemTurianPower;
    local float DirectDamage;
    
    if (Power != None && m_oPawn.Role == ENetRole.ROLE_Authority)
    {
        FemTurianPower = SFXPowerCustomActionMP_FemTurianMeleePassive(Power);
        if (FemTurianPower != None)
        {
            DirectDamage = (1.0 - FemTurianPower.PoisonDamage) * FemTurianPower.HeavyMeleeDamage.CurrentValue;
            if (SyncPartner != None)
            {
                if (VSize(SyncPartner.location - m_oPawn.location) - SyncPartner.GetCollisionRadius() < Power.HeavyMeleeImpactRadius.CurrentValue)
                {
                    Power.DoAreaExplosionForActor(SyncPartner, m_oPawn.location, 0, DirectDamage, DamageType, Power.HeavyMeleeForce.CurrentValue, MeleeImpactParameters, 0, OnActorImpacted);
                }
            }
            else
            {
                MeleeImpactParameters.ConeDirection = Vector(m_oPawn.Rotation);
                Power.AreaExplosion(m_oPawn.location, Power.HeavyMeleeImpactRadius.CurrentValue, DirectDamage, DamageType, Power.HeavyMeleeForce.CurrentValue, MeleeImpactParameters, 1, OnActorImpacted);
            }
        }
    }
}
public function StopCustomAction()
{
    Super.StopCustomAction();
    DetachBlades();
}
public final simulated function DetachBlades()
{
    if (m_oPawn.Mesh != None)
    {
        if (SFXPawn_PlayerMP_Vanguard_TurianFemale(m_oPawn) != None)
        {
            SFXPawn_PlayerMP_Vanguard_TurianFemale(m_oPawn).HideBlades();
        }
    }
}
public function StartTeleportVFX()
{
    if (!bCloakEffectStarted)
    {
        DetachBlades();
    }
    Super.StartTeleportVFX();
}
public function StopTeleportVFX()
{
    if (bCloakEffectStarted)
    {
        AttachBlades();
    }
    Super.StopTeleportVFX();
}
public function AttachBlades()
{
    if (m_oPawn.Mesh != None)
    {
        if (SFXPawn_PlayerMP_Vanguard_TurianFemale(m_oPawn) != None)
        {
            SFXPawn_PlayerMP_Vanguard_TurianFemale(m_oPawn).ExposeBlades();
        }
    }
}

