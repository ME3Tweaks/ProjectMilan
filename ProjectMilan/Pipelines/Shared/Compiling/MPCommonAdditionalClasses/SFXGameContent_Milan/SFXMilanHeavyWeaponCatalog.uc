// Shared runtime catalog generated by HeavyWeaponsPipeline. IDs are permanent, not UI indices.
Class SFXMilanHeavyWeaponCatalog extends Object config(Game);

struct HeavyWeaponEntry
{
    var int Id;
    var string ClassPath;
    var stringref DisplayName;
    var stringref ShortName;
    var stringref Description;
    var string Image;
    var string Icon;
    var string IconResource;
    var int IconIndex;
    var bool bHidden;
    var bool bNoWeapon;
    var string Rarity;
};
var config array<HeavyWeaponEntry> Weapons;
var config stringref CategoryLabel;
var config stringref HiddenLabel;
var transient bool bHasLocalSelection;
var transient int LocalSelectionId;

public static final function RememberLocalSelection(int Id)
{
    default.LocalSelectionId = NormalizeId(Id);
    default.bHasLocalSelection = TRUE;
}
public static final function int GetLocalSelection(int CurrentId)
{
    return NormalizeId(default.bHasLocalSelection ? default.LocalSelectionId : CurrentId);
}

public static final function int FindIndex(int Id)
{
    return default.Weapons.Find('Id', Id);
}
public static final function int NormalizeId(int Id)
{
    return FindIndex(Id) != -1 ? Id : 0;
}
// HeavyWeapons regenerates this body from the validated UI catalog.
public static final function class<SFXHeavyWeapon> ResolveClass(int Id)
{
    local int Index;
    local class<SFXHeavyWeapon> WeaponClass;
    Index = FindIndex(NormalizeId(Id));
    if (Index != -1 && default.Weapons[Index].bNoWeapon)
    {
        return None;
    }
    if (Index != -1)
    {
        WeaponClass = class<SFXHeavyWeapon>(DynamicLoadObject(default.Weapons[Index].ClassPath, Class'Class', TRUE));
    }
    if (WeaponClass == None)
    {
        WeaponClass = Class'SFXWeapon_Heavy_ConsumableRocketLauncher';
    }
    return WeaponClass;
}

defaultproperties
{
    Weapons = ({Id=0,ClassPath="SFXGameMPContent.SFXWeapon_Heavy_ConsumableRocketLauncher",DisplayName=$661166,ShortName=$340356,Description=$661351,Image="GUI_Codex_Weapons_Images.Weapons.hvy_titan_512x256",Icon="GUI_Icons.Weapons.hvy_titan_256x128",IconResource="GUI_SF_ME2_Weapon_Icons.ME2_Weapon_Icons",IconIndex=49,Rarity="common"})
}
