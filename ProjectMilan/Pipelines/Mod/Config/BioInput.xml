				<Value type="3">( Name="XboxTypeS_DPad_Down", Command="Console_UseRevivePower" )</Value>
				<Value type="3">( Name="SpaceBar", Command="PC_ProlongLife" )</Value>
				<Value type="3">( Name="Seven", Command="PC_UseRevivePower" )</Value>
			</Property>
		</Section>
		<Section name="sfxgame.sfxgamemodebase">
			<Property name="bindings">
				<!-- add binds for GameModeDying binds to direct to -->
				<Value type="3">( Name="Console_ProlongLife", Command="ProlongLife" )</Value>
				<Value type="3">( Name="PC_ProlongLife", Command="ProlongLife" )</Value>
				<Value type="3">( Name="Console_UseRevivePower", Command="UseRevivePower" )</Value>
				<Value type="3">( Name="PC_UseRevivePower", Command="UseRevivePower" )</Value>
			</Property>
		</Section>
		<!-- END MILAN -->
	</Sections>
