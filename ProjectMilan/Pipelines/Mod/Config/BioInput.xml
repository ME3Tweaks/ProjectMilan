<?xml version="1.0" encoding="utf-8"?>
<CoalesceAsset id="BioInput" name="bioinput.ini" source="..\..\biogame\config\bioinput.ini">
	<Sections>
		<Section name="configuration">
			<Property name="basedon" type="0">..\..\BIOGame\DLC\DLC_Shared\Config\DefaultInput.ini</Property>
		</Section>
		<!-- MILAN change DropTheSquid 12/10/2023 -->
		<Section name="sfxgame.sfxgamemodedying">
			<Property name="bindings">
				<!-- remove the original ambiguous binds (when asking for the binding for ProlongLife is is undefined/inconsistent/unintuitive whether it will give you the PC or Console bind) -->
				<Value type="4">( Name="XboxTypeS_A", Command="ProlongLife" )</Value>
				<Value type="4">( Name="XboxTypeS_DPad_Down", Command="UseRevivePower" )</Value>
				<Value type="4">( Name="SpaceBar", Command="ProlongLife" )</Value>
				<Value type="4">( Name="Seven", Command="UseRevivePower" )</Value>
