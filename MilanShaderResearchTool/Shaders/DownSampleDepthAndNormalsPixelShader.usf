/*=============================================================================
	DownSampleDepthAndNormalsPixelShader.usf: Downsamples scene depth and normals by a factor of 2.
=============================================================================*/

#include "Common.usf"

float2 ProjectionScaleBias;
float4 SourceTexelOffsets01;
float4 SourceTexelOffsets23;
// BW_START - December 31, 2020 - Leonardo Benaducci - Multi frame ambient occlusions smoothing
uint OffsetIndex;
// BW_END
SAMPLER2D(FullSizedNormalsTexture);

// BW_START - December 31, 2020 - Leonardo Benaducci - Multi frame ambient occlusions smoothing
#define USE_INTERLEAVED_APPROACH 1
// BW_END
// BW_START - December 17, 2020 - Leonardo Benaducci - [JIRA:METR-39368] Average depth and normals
#define USE_AVERAGE_DEPTH_AND_NORMALS 0
// BW_END

void Main(
	float2 InUV : TEXCOORD0,
	out float OutDepth : DEPTH,
	// BW_START - September 15, 2010 - Wihlidal, Graham - PS3 Fragment and Vertex Shader Optimizations
	// BW_MORE - December 10, 2020 - Chan, Patrick - [JIRA:METR-39898] Allow backface shadows on Characters only
	out half2 OutColor : SV_Target0
	// BW_END
	)
{

// BW_START - December 31, 2020 - Leonardo Benaducci - Multi frame ambient occlusions smoothing
#if USE_INTERLEAVED_APPROACH

	float2 Offsets[4] = {SourceTexelOffsets01.xy, SourceTexelOffsets01.zw, SourceTexelOffsets23.xy, SourceTexelOffsets23.zw };
	float ViewSpaceZ = CalcSceneDepth(InUV + Offsets[OffsetIndex].xy);
	
	OutDepth = (ViewSpaceZ * ProjectionScaleBias.x + ProjectionScaleBias.y) / ViewSpaceZ;
	OutColor = tex2D(FullSizedNormalsTexture,InUV + Offsets[OffsetIndex].xy).rg;

// BW_END
// BW_START - December 17, 2020 - Leonardo Benaducci - [JIRA:METR-39368] Average depth and normals
#elif !USE_AVERAGE_DEPTH_AND_NORMALS
// BW_END
	// Lookup the four view space Z's of the full resolution pixels corresponding to this low resolution pixel
	float FurthestDepth = CalcSceneDepth(InUV + SourceTexelOffsets01.xy);	// ViewSpaceZ0
	// BW_START - December 10, 2020 - Chan, Patrick - [JIRA:METR-39898] Allow backface shadows on Characters only
	OutColor = tex2D(FullSizedNormalsTexture,InUV + SourceTexelOffsets01.xy).rg;
	// BW_END
	float ViewSpaceZ1 = CalcSceneDepth(InUV + SourceTexelOffsets01.zw);
	if (ViewSpaceZ1 > FurthestDepth)
	{
		FurthestDepth = ViewSpaceZ1;
		// BW_START - December 10, 2020 - Chan, Patrick - [JIRA:METR-39898] Allow backface shadows on Characters only
		OutColor = tex2D(FullSizedNormalsTexture,InUV + SourceTexelOffsets01.zw).rg;
		// BW_END
	}
	float ViewSpaceZ2 = CalcSceneDepth(InUV + SourceTexelOffsets23.xy);
	if (ViewSpaceZ2 > FurthestDepth)
	{
		FurthestDepth = ViewSpaceZ2;
		// BW_START - December 10, 2020 - Chan, Patrick - [JIRA:METR-39898] Allow backface shadows on Characters only
		OutColor = tex2D(FullSizedNormalsTexture,InUV + SourceTexelOffsets23.xy).rg;
		// BW_END
	}
	float ViewSpaceZ3 = CalcSceneDepth(InUV + SourceTexelOffsets23.zw);
	if (ViewSpaceZ3 > FurthestDepth)
	{
		FurthestDepth = ViewSpaceZ3;
		// BW_START - December 10, 2020 - Chan, Patrick - [JIRA:METR-39898] Allow backface shadows on Characters only
		OutColor = tex2D(FullSizedNormalsTexture,InUV + SourceTexelOffsets23.zw).rg;
		// BW_END
	}

	// Convert view space Z into post projection Z and output post projection Z / W as the depth buffer expects.
	OutDepth = (FurthestDepth * ProjectionScaleBias.x + ProjectionScaleBias.y) / FurthestDepth;

// BW_START - December 17, 2020 - Leonardo Benaducci - [JIRA:METR-39368] Average depth and normals
#else
	float4 ViewSpaceZ = float4( CalcSceneDepth(InUV + SourceTexelOffsets01.xy),
								CalcSceneDepth(InUV + SourceTexelOffsets01.zw),
								CalcSceneDepth(InUV + SourceTexelOffsets23.xy),
								CalcSceneDepth(InUV + SourceTexelOffsets23.zw));
	
	ViewSpaceZ = dot(ViewSpaceZ, 1.f) * 0.25f;
	OutDepth = (ViewSpaceZ.x * ProjectionScaleBias.x + ProjectionScaleBias.y) / ViewSpaceZ.x;
	
	float2 OutNormal = 0.f;
	OutNormal += tex2D(FullSizedNormalsTexture,InUV + SourceTexelOffsets01.xy).rg;
	OutNormal += tex2D(FullSizedNormalsTexture,InUV + SourceTexelOffsets01.zw).rg;
	OutNormal += tex2D(FullSizedNormalsTexture,InUV + SourceTexelOffsets23.xy).rg;
	OutNormal += tex2D(FullSizedNormalsTexture,InUV + SourceTexelOffsets23.zw).rg;
	OutNormal *= .25f;
	
	OutColor = OutNormal;
#endif
// BW_END
}
