#include "Common.usf"

#if SM5_PROFILE	
	#define UINT						uint
	#define UINT2						uint2
	#define TEX2D(tex, coord, size)		tex.Load(float3(coord*size, 0))	
#else
	#define UINT						int
	#define UINT2						int2
	#define TEX2D(tex, coord, size)		tex2Dlod(tex, float4(coord, 0, 0))	
#endif

//-----------------------------------------------------------------------------------------
// Defines
//-----------------------------------------------------------------------------------------
// If the following is defined then input colors are considered to be in sRGB space
#define INPUT_IS_IN_GAMMA_SPACE 1               // we operate is sRGB space

#ifndef MAX_EDGE_COUNT_BITS
#define MAX_EDGE_COUNT_BITS 4							
#endif

#ifndef SHOW_EDGES
#define SHOW_EDGES 0							// Disabled by default      
#endif

//-----------------------------------------------------------------------------------------
// Static Constants
//-----------------------------------------------------------------------------------------
// Set the number of bits to use when storing the horizontal and vertical counts
// This number should be half the number of bits in the color channels used
// E.g. with a RT format of DXGI_R8G8_int this number should be 8/2 = 4
// Longer edges can be detected by increasing this number; however this requires a 
// larger bit depth format, and also makes the edge length detection function slower
static const UINT kNumCountBits				= MAX_EDGE_COUNT_BITS;

// The maximum edge length that can be detected
static const UINT kMaxEdgeLength			= ( (1<<(kNumCountBits-1)) - 1 );

// Various constants used by the shaders below
static const UINT kUpperMask				= (1<<0);
static const UINT kUpperMask_BitPosition	= 0;
static const UINT kRightMask				= (1<<1);
static const UINT kRightMask_BitPosition	= 1;
static const UINT kStopBit					= (1<<(kNumCountBits-1));
static const UINT kStopBit_BitPosition		= (kNumCountBits-1);
static const UINT kNegCountShift			= (kNumCountBits);
static const UINT kPosCountShift			= (00);
static const UINT kCountShiftMask			= ((1<<kNumCountBits)-1);

static const int3 kZero						= int3( 0, 0, 0);
static const int3 kUp						= int3( 0,-1, 0);
static const int3 kDown						= int3( 0, 1, 0);
static const int3 kRight					= int3( 1, 0, 0);
static const int3 kLeft						= int3(-1, 0, 0);

//-----------------------------------------------------------------------------------------
// Constants
//-----------------------------------------------------------------------------------------
// (x, y, z) - The luminance equation is used to convert pixel color to luminance value for edge detection and color blending.
// (w) - This constant defines the luminance intensity difference to check for when testing any two pixels for an edge.
//       The higher the value the fewer edges wil be detected.
float4 gLuminanceEquation;
// Render target size
float2 gRTSize;
// Inverse value of display Gamma
float gInverseDisplayGamma;
//-----------------------------------------------------------------------------------------
// Shader resources
//-----------------------------------------------------------------------------------------
// Render target for edge detection
SAMPLER2D(EdgeMaskTexture)
// Render target for edge length computing
SAMPLER2D(EdgeCountTexture)

//-----------------------------------------------------------------------------------------
// Utility functions
//-----------------------------------------------------------------------------------------
// Covert pixel color to luminance value
float GetLuminance(float3 color)
{
    return dot(color, gLuminanceEquation.xyz);
}

// Returns true if the colors are different
bool CompareColors( float3 a, float3 b )
{
    return ( abs( GetLuminance(a) - GetLuminance(b) ) > gLuminanceEquation.w );
}

float2 ComputeOffset(float2 pos, float2 offset, float2 min, float2 max)
{
	return float2( clamp( pos + offset, min, max).xy);
}

float2 manual_vect_mult(float2 a, float2 b)
{
    return float2(a.x*b.x, a.y*b.y);
}

#if SM5_PROFILE	
	bool IsBitSet(UINT Value, const UINT uBitPosition)
	{
		return ((Value & (1<<uBitPosition)) ? true : false);
	}	
	
	UINT BitwiseOR(UINT a, UINT b)
	{
		return (a | b);
	}
	
	UINT RemoveStopBit(UINT a)
	{
		return a & (kStopBit-1);
	}

	UINT DecodeCountNoStopBit(UINT count, UINT shift)
	{
		return RemoveStopBit((count >> shift) & kCountShiftMask);
	}

	UINT DecodeCount(UINT count, UINT shift)
	{
		return (count >> shift) & kCountShiftMask;
	}

	UINT EncodeCount(UINT negCount, UINT posCount)
	{
		return ((negCount & kCountShiftMask) << kNegCountShift) | (posCount & kCountShiftMask);
	}
	
	float EncodeMaskColor(UINT mask)
	{
		return float(mask/255.0);		
	}
	
	UINT DecodeMaskColor(float mask)
	{
		return UINT(mask * 255);		
	}	
	
	float EncodeCountColor(UINT mask)
	{
		return float(mask);
	}
	UINT DecodeCountColor(float mask)
	{
		return UINT(mask);
	}
	
	UINT2 DecodeCountColor2(float2 mask)
	{
		return UINT2(mask);
	}	
#else	
	bool IsBitSet(float fValue, const UINT uBitPosition)
	{
		const float fModulo[9] = { 1, 2, 4, 8, 16, 32, 64, 128, 256 };

		return (fmod(fValue, fModulo[uBitPosition+1]) >= fModulo[uBitPosition]);
	}	
	
	UINT BitwiseOR(UINT a, UINT b)
	{
		return (a + b);
	}
	
	UINT RemoveStopBit(UINT a)
	{
		a = a - ( IsBitSet(float(a), kStopBit_BitPosition) ? kStopBit : 0 );    
		return a;
	}	
	
	UINT DecodeCount(UINT count, UINT shift)
	{
		return UINT(fmod( float(count) / pow(2, shift), kCountShiftMask+1));
	}

	UINT DecodeCountNoStopBit(UINT count, UINT shift)
	{
		return RemoveStopBit( floor( fmod( float(count) / pow(2,shift), kCountShiftMask+1 ) ) );
	}	

	UINT EncodeCount(UINT negCount, UINT posCount)
	{
		return int(floor((fmod(float(negCount), kCountShiftMask+1))) * (1<<kNegCountShift) ) + floor((fmod(float(posCount), kCountShiftMask+1)));
	}	
	
	float EncodeMaskColor(UINT mask)
	{
		return float(mask);
	}
	
	UINT DecodeMaskColor(float mask)
	{
		return UINT(mask);
	}	
	
	float EncodeCountColor(UINT mask)
	{
		return float(mask);
	}
	
	UINT DecodeCountColor(float mask)
	{
		return UINT(mask);
	}
	
	UINT2 DecodeCountColor2(float2 mask)
	{
		return UINT2(mask);
	}
#endif

/*-----------------------------------------------------------------------------
	MLAA vertex shader
-----------------------------------------------------------------------------*/
void MLAA_VertexMain(
	in float4 InPosition : POSITION,
	in float2 UV : TEXCOORD0,
	out float2 OutCenterUV : TEXCOORD0,
	out float4 OutPosition : SV_Position
	)
{
	OutPosition = InPosition;
	OutCenterUV = UV.xy;
}

/*-----------------------------------------------------------------------------
	MLAA pixel shader for edge detection.
	Pixel shader used in the first phase of MLAA.
	This pixel shader is used to detect vertical and horizontal edges.
-----------------------------------------------------------------------------*/
void MLAA_SeperatingLines_PS(    
	float2 InCenterUV : TEXCOORD0,
	out float4 OutColor : SV_Target0
	)
{
#if INPUT_IS_IN_GAMMA_SPACE
	float3 center = (CalcSceneColor( ComputeOffset(InCenterUV, float2(0, 0),			float2(0, 0), float2(1, 1)) ));
	float3 up	  = (CalcSceneColor( ComputeOffset(InCenterUV, kUp.xy/gRTSize.xy,	float2(0, 0), float2(1, 1)) ));
	float3 right  = (CalcSceneColor( ComputeOffset(InCenterUV, kRight.xy/gRTSize.xy,	float2(0, 0), float2(1, 1)) ));	
#else
	// switch to Gamma space first if the input source is in linear space
	float3 center = pow(CalcSceneColor( ComputeOffset(InCenterUV, float2(0, 0),			float2(0, 0), float2(1, 1)) ), gInverseDisplayGamma);
	float3 up	  = pow(CalcSceneColor( ComputeOffset(InCenterUV, kUp.xy/gRTSize.xy,	float2(0, 0), float2(1, 1)) ), gInverseDisplayGamma);
	float3 right  = pow(CalcSceneColor( ComputeOffset(InCenterUV, kRight.xy/gRTSize.xy,	float2(0, 0), float2(1, 1)) ), gInverseDisplayGamma);
#endif
	UINT rVal = 0;		
	
	// Check for seperating lines
	if ( CompareColors( center, up )) 
		rVal = BitwiseOR(rVal, kUpperMask);
	if ( CompareColors( center, right ))
		rVal = BitwiseOR(rVal,  kRightMask);
	
	float fVal = EncodeMaskColor(rVal);	
	OutColor = float4(fVal, fVal, fVal, 1);	
}	

/*-----------------------------------------------------------------------------
	MLAA pixel shader
-----------------------------------------------------------------------------*/
void ComputeEdgeCount(	
		in UINT pixel,
		in float2 InCenterUV,
		in out UINT HorizontalCount_Negative,
		in out UINT HorizontalCount_Positive,
		in out UINT VerticalCount_Negative,
		in out UINT VerticalCount_Positive	
		)
{
	#if SM5_PROFILE	
		// We use a single branch for vertical and horizontal edge testing
		// Doing this is faster than two different branches (one for vertical, one for horizontal)
		// In most case both V and H edges are spatially coherent (apart from purely horizontal or 
		// vertical edges but those don't happen often compared to other cases).
		if ( (pixel & (kUpperMask | kRightMask)) )
		{
			UINT uVNegEdgeFound = (pixel & kUpperMask) ? 0xFFFFFFFF : 0;
			UINT uVPosEdgeFound = uVNegEdgeFound;
			UINT VStopBit = uVNegEdgeFound ? kStopBit : 0;  // A bit of clever code: nullify the stopbit if we're not supposed to look at this edge
			UINT uHNegEdgeFound = (pixel & kRightMask) ? 0xFFFFFFFF : 0;
			UINT uHPosEdgeFound = uHNegEdgeFound;
			UINT HStopBit = uHNegEdgeFound ? kStopBit : 0;  // A bit of clever code: nullify the stopbit if we're not supposed to look at this edge
	        
			UNROLL
			for (int i=1; i<=int(kMaxEdgeLength); i++)
			{
				// Vertical edges            
	            
				// Negative
				UINT VMask_Neg = DecodeMaskColor(tex2Dlod(EdgeMaskTexture, float4(clamp(InCenterUV + float2(-i, 0)/gRTSize, float2(0, 0), float2(1, 1)), 0, 0)).r);
				uVNegEdgeFound = (uVNegEdgeFound & (VMask_Neg & kUpperMask));
				HorizontalCount_Negative = uVNegEdgeFound ? (HorizontalCount_Negative+1) : (HorizontalCount_Negative | VStopBit);
	            
				// Positive
				UINT VMask_Pos = DecodeMaskColor(tex2Dlod(EdgeMaskTexture, float4(clamp(InCenterUV + float2(i, 0)/gRTSize, float2(0, 0), float2(1, 1)), 0, 0)).r);
				uVPosEdgeFound = (uVPosEdgeFound & (VMask_Pos & kUpperMask));
				HorizontalCount_Positive = uVPosEdgeFound ? (HorizontalCount_Positive+1) : (HorizontalCount_Positive | VStopBit);
				            
	            
				// Horizontal edges
	            
				// Negative
				UINT HMask_Neg = DecodeMaskColor(tex2Dlod(EdgeMaskTexture, float4(clamp(InCenterUV + float2(0, i)/gRTSize, float2(0, 0), float2(1, 1)), 0, 0)).r);				
				uHNegEdgeFound = (uHNegEdgeFound & (HMask_Neg & kRightMask));
				VerticalCount_Negative = uHNegEdgeFound ? (VerticalCount_Negative+1) : (VerticalCount_Negative | HStopBit);
					            
				// Positive
				UINT HMask_Pos = DecodeMaskColor(tex2Dlod(EdgeMaskTexture, float4(clamp(InCenterUV + float2(0, -i)/gRTSize, float2(0, 0), float2(1, 1)), 0, 0)).r);				
				uHPosEdgeFound = (uHPosEdgeFound & (HMask_Pos & kRightMask));
				VerticalCount_Positive = uHPosEdgeFound ? (VerticalCount_Positive+1) : (VerticalCount_Positive | HStopBit);				
			}        
		}	    
	#else			
		UINT uVNegEdgeFound = IsBitSet(pixel, kUpperMask_BitPosition) ? 0xFFFF : 0;
		UINT uHNegEdgeFound = IsBitSet(pixel, kRightMask_BitPosition) ? 0xFFFF : 0;	            
	        
	    // We use a single branch for vertical and horizontal edge testing
		// Doing this is faster than two different branches (one for vertical, one for horizontal)
		// In most case both V and H edges are spatially coherent (apart from purely horizontal or 
		// vertical edges but those don't happen often compared to other cases).	      
		if ( uVNegEdgeFound || uHNegEdgeFound )
		{
			UINT uVPosEdgeFound = uVNegEdgeFound;
			UINT VStopBit = uVNegEdgeFound ? kStopBit : 0;  // A bit of clever code: nullify the stopbit if we're not supposed to look at this edge
			UINT uHPosEdgeFound = uHNegEdgeFound;
			UINT HStopBit = uHNegEdgeFound ? kStopBit : 0;  // A bit of clever code: nullify the stopbit if we're not supposed to look at this edge
	        
			for (int i=1; i<=int(kMaxEdgeLength); i++)
			{
				// Vertical edges            
	            
				// Negative
				if (!(IsBitSet(HorizontalCount_Negative, kStopBit_BitPosition)))		
				{
					UINT VMask_Neg = DecodeMaskColor(tex2Dlod(EdgeMaskTexture, float4(clamp(InCenterUV + float2(-i, 0)/gRTSize, float2(0, 0), float2(1, 1)), 0, 0)).r);
					uVNegEdgeFound = (IsBitSet(VMask_Neg, kUpperMask_BitPosition)) ? kUpperMask : 0;
					HorizontalCount_Negative = uVNegEdgeFound ? (HorizontalCount_Negative+1) : BitwiseOR(HorizontalCount_Negative, VStopBit);
				}
	            
				// Positive
				if (!(IsBitSet(HorizontalCount_Positive, kStopBit_BitPosition)))		
				{
					UINT VMask_Pos = DecodeMaskColor(tex2Dlod(EdgeMaskTexture, float4(clamp(InCenterUV + float2(i, 0)/gRTSize, float2(0, 0), float2(1, 1)), 0, 0)).r);
					uVPosEdgeFound = (IsBitSet(VMask_Pos, kUpperMask_BitPosition)) ? kUpperMask : 0;
					HorizontalCount_Positive = uVPosEdgeFound ? (HorizontalCount_Positive+1) : BitwiseOR(HorizontalCount_Positive, VStopBit);
				}
	            
	            
				// Horizontal edges
	            
				// Negative
				if (!(IsBitSet(VerticalCount_Negative, kStopBit_BitPosition)))		
				{
					UINT HMask_Neg = DecodeMaskColor(tex2Dlod(EdgeMaskTexture, float4(clamp(InCenterUV + float2(0, i)/gRTSize, float2(0, 0), float2(1, 1)), 0, 0)).r);
					uHNegEdgeFound = (IsBitSet(HMask_Neg, kRightMask_BitPosition)) ? kRightMask : 0;
					VerticalCount_Negative = uHNegEdgeFound ? (VerticalCount_Negative+1) : BitwiseOR(VerticalCount_Negative, HStopBit);
				}
	            
				// Positive
				if (!(IsBitSet(VerticalCount_Positive, kStopBit_BitPosition)))		
				{
					UINT HMask_Pos = DecodeMaskColor(tex2Dlod(EdgeMaskTexture, float4(clamp(InCenterUV + float2(0, -i)/gRTSize, float2(0, 0), float2(1, 1)), 0, 0)).r);
					uHPosEdgeFound = (IsBitSet(HMask_Pos, kRightMask_BitPosition)) ? kRightMask : 0;
					VerticalCount_Positive = uHPosEdgeFound ? (VerticalCount_Positive+1) : BitwiseOR(VerticalCount_Positive, HStopBit);
				}
			} 
		}    	
	#endif
}

/*-----------------------------------------------------------------------------
	Pixel shader for the second phase of the algorithm
	This pixel shader calculates the length of edges
-----------------------------------------------------------------------------*/
void MLAA_ComputeLineLength_PS(
	float2 InCenterUV : TEXCOORD0,
	out float4 OutColor : SV_Target0
	)
{
	// Retrieve edge mask for current pixel
	UINT pixel = DecodeMaskColor(tex2Dlod(EdgeMaskTexture, float4(InCenterUV, 0, 0)).r);	
	
    UINT HorizontalCount_Negative = 0;
    UINT HorizontalCount_Positive = 0;
    UINT VerticalCount_Negative = 0;
    UINT VerticalCount_Positive = 0;
    
    ComputeEdgeCount(pixel, InCenterUV, HorizontalCount_Negative, HorizontalCount_Positive, VerticalCount_Negative, VerticalCount_Positive);
        
    OutColor.x = EncodeCountColor(EncodeCount(HorizontalCount_Negative, HorizontalCount_Positive));
    OutColor.y = EncodeCountColor(EncodeCount(VerticalCount_Negative, VerticalCount_Positive));
    OutColor.z = 0;
    OutColor.w = 1;
}

/*-----------------------------------------------------------------------------	
	Main function used in third and final phase of the algorithm
	This code reads previous inputs and perform anti-aliasing of edges by 
    blending colors as required
-----------------------------------------------------------------------------*/
void BlendColor(UINT count,
                float2 pos, 
                float2 dir, 
                float2 ortho, 
                bool inverse, 
                in out float4 color)
{
    // Only process pixel edge if it contains a stop bit
    if ( IsBitSet(count, kStopBit_BitPosition+kPosCountShift) || IsBitSet(count, kStopBit_BitPosition+kNegCountShift) )  
    {
        // Retrieve edge length
        UINT negCount = DecodeCountNoStopBit(count, kNegCountShift);
        UINT posCount = DecodeCountNoStopBit(count, kPosCountShift);
        
        // Fetch color adjacent to the edge
        float4 adjacentcolor = tex2Dlod(SceneColorTexture, float4(pos+dir, 0, 0));
        
        FLATTEN
        if ( (negCount + posCount) == 0)
        {
	        float weight = 1.0/8.0; // Arbitrary
	        color = lerp(color, adjacentcolor, weight);
        }
        else
        {
            // If no sign bit is found on either edge then artificially increase the edge length so that
            // we don't start anti-aliasing pixels for which we don't have valid data (
			if ( !(IsBitSet(count, (kStopBit_BitPosition+kPosCountShift)))) posCount = kMaxEdgeLength+1;
			if ( !(IsBitSet(count, (kStopBit_BitPosition+kNegCountShift)))) negCount = kMaxEdgeLength+1;
			
            // Calculate some variables
            float length = negCount + posCount + 1;
            float midPoint = (length)/2;
            float distance = (float)negCount;
            
            static const UINT upperU   = 0x00;
            static const UINT risingZ  = 0x01;
            static const UINT fallingZ = 0x02;
            static const UINT lowerU   = 0x03;

            ///////////////////////////////////////////////////////////////////////////////////////
            // Determining what pixels to blend
            // 4 possible values for shape - x indicates a blended pixel:
            //
            // 0: |xxxxxx| -> (h0 > 0) && (h1 > 0) : upperU     - blend along the entire inverse edge
            //     ------
            //
            //
            // 1:     xxx| -> (h0 < 0) && (h1 > 0) : risingZ    - blend first half on inverse, 
            //     ------                                         blend second half on non-inverse
            //    |xxx                                            
            //
            // 2: |xxx     -> (h0 > 0) && (h1 < 0) : fallingZ   - blend first half on non-inverse, 
            //     ------                                         blend second half on inverse
            //        xxx|                                        
            //
            // 3:          -> (h0 < 0) && (h1 < 0) : lowerU     - blend along the entire non-inverse edge
            //     ------
            //    |xxxxxx|
            ///////////////////////////////////////////////////////////////////////////////////////

            UINT shape = 0x00;
        #if INPUT_IS_IN_GAMMA_SPACE
			if (CompareColors((tex2Dlod(SceneColorTexture, float4(pos-(ortho*negCount.xx), 0, 0)).rgb), (tex2Dlod(SceneColorTexture, float4(pos-(ortho*(negCount.xx+1)), 0, 0)).rgb)))
            {
                shape = BitwiseOR(shape, risingZ);                
            }
            if (CompareColors((tex2Dlod(SceneColorTexture, float4(pos+(ortho*posCount.xx), 0, 0)).rgb), (tex2Dlod(SceneColorTexture, float4(pos+(ortho*(posCount.xx+1)), 0, 0)).rgb)))
            {
                shape = BitwiseOR(shape, fallingZ);                
            }
        #else
			if (CompareColors(pow(tex2Dlod(SceneColorTexture, float4(pos-(ortho*negCount.xx), 0, 0)).rgb, gInverseDisplayGamma), pow(tex2Dlod(SceneColorTexture, float4(pos-(ortho*(negCount.xx+1)), 0, 0)).rgb, gInverseDisplayGamma)))
            {
                shape = BitwiseOR(shape, risingZ);                
            }
            if (CompareColors(pow(tex2Dlod(SceneColorTexture, float4(pos+(ortho*posCount.xx), 0, 0)).rgb, gInverseDisplayGamma), pow(tex2Dlod(SceneColorTexture, float4(pos+(ortho*(posCount.xx+1)), 0, 0)).rgb, gInverseDisplayGamma)))
            {
                shape = BitwiseOR(shape, fallingZ);                
            }
        #endif
			// Parameter "inverse" is hard-coded on call so will not generate a dynamic branch condition
			FLATTEN
			if (    (  inverse && ( ( (shape == fallingZ) && (float(negCount) <= midPoint) ) ||
									( (shape == risingZ)  && (float(negCount) >= midPoint) ) ||
									( (shape == upperU)                             ) ) ) 
				 || ( !inverse && ( ( (shape == fallingZ) && (float(negCount) >= midPoint) ) ||
									( (shape == risingZ)  && (float(negCount) <= midPoint) ) ||
									( (shape == lowerU)                             ) ) ) )
			{
				float h0 = abs( (1.0/length) * (length-distance)     - 0.5);
				float h1 = abs( (1.0/length) * (length-distance-1.0) - 0.5);
				float area = 0.5 * (h0+h1);				
				#if INPUT_IS_IN_GAMMA_SPACE
					// Cheap approximation of gamma to linear and then back again
					color.xyz = sqrt( lerp(color.xyz*color.xyz, adjacentcolor.xyz*adjacentcolor.xyz, area) );
				#else
					color.xyz = lerp(color.xyz, adjacentcolor.xyz, area);
				#endif
			}
		}
    }
}

/*-----------------------------------------------------------------------------
	MLAA pixel shader for color blending.
	Pixel shader used in third and final phase of the algorithm
-----------------------------------------------------------------------------*/
void MLAA_BlendColor_PS(
	float2 InCenterUV : TEXCOORD0,
	out float4 OutColor : SV_Target0
	)
{
#if SHOW_EDGES	
    float4 rVal;
    
    // Retrieve pixel from original image
    rVal.rgb = CalcSceneColor(InCenterUV);
    rVal.a = 1;    
    
    #ifdef ORBIS // METR_TODO: Orbis doesn't like this cheeky assignment.  Make sure this doesn't tank performance.
        UINT2 counts = DecodeCountColor2(tex2Dlod(EdgeCountTexture, float4(InCenterUV, 0, 0)).xy);
        UINT hcount = counts.x;
        UINT vcount = counts.y;
    #else
        UINT hcount, vcount;
	    UINT2(hcount, vcount) = DecodeCountColor2(tex2Dlod(EdgeCountTexture, float4(InCenterUV, 0, 0)).xy);
    #endif
        
    // If the pixel is in edge
    if (hcount || vcount)
		OutColor = float4(1, 0, 0, 1);
    else
		OutColor = rVal;  				
#else
    // Retrieve pixel from original image
    float4 rVal = float4(CalcSceneColor(InCenterUV), 1);    
    
	
    #ifdef ORBIS // METR_TODO: Orbis doesn't like this cheeky assignment.  Make sure this doesn't tank performance.
        UINT2 counts = DecodeCountColor2(tex2Dlod(EdgeCountTexture, float4(InCenterUV, 0, 0)).xy);
        UINT hcount = counts.x;
        UINT vcount = counts.y;
    #else
        UINT hcount, vcount;
	    UINT2(hcount, vcount) = DecodeCountColor2(tex2Dlod(EdgeCountTexture, float4(InCenterUV, 0, 0)).xy);
    #endif

	UINT hcountup    = DecodeCountColor(tex2Dlod(EdgeCountTexture, float4(InCenterUV-(kUp.xy/gRTSize),	0, 0)).x);
	UINT vcountright = DecodeCountColor(tex2Dlod(EdgeCountTexture, float4(InCenterUV-(kRight.xy/gRTSize),	0, 0)).y);
	
    // Blend pixel colors as required for anti-aliasing edges
    BlendColor( hcount,      InCenterUV,							 float2(kUp.xy)/gRTSize,	float2(kRight.xy)/gRTSize, false, rVal);   // H down-up
    BlendColor( hcountup,    InCenterUV-float2(kUp.xy)/gRTSize,    float2(kZero.xy),			float2(kRight.xy)/gRTSize, true,  rVal);   // H up-down
    BlendColor( vcount,      InCenterUV,							 float2(kRight.xy)/gRTSize,	float2(kUp.xy)/gRTSize,    false, rVal);   // V left-right
    BlendColor( vcountright, InCenterUV-float2(kRight.xy)/gRTSize, float2(kZero.xy),			float2(kUp.xy)/gRTSize,    true,  rVal);   // V right-left

    OutColor = rVal;
#endif
}
