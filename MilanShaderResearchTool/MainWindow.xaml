<Window x:Class="MilanShaderResearchTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MilanShaderResearchTool"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="Milan Shader Research Tool" Height="900" Width="1400">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Configuration -->
        <GroupBox Grid.Row="0" Header="Shader Configuration" Margin="0,0,0,4">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Debug Package:" VerticalAlignment="Center" Margin="0,0,4,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="MaterialHlslPathBox" IsReadOnly="True" Margin="0,0,4,4"/>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="Browse..." Click="BrowseMaterialHlsl_Click" Padding="8,2" Margin="0,0,4,0"/>
                    <Button Content="Reload" Click="ReloadDebugPackage_Click" Padding="8,2"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Base Shader:" VerticalAlignment="Center" Margin="0,0,4,4"/>
                <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4">
                    <ComboBox x:Name="BaseShaderNameBox" Width="200" Text="DirectionalLightPixelShader" IsEditable="True" Margin="0,0,8,0" SelectionChanged="BaseShaderNameBox_SelectionChanged"/>
                    <TextBlock Text="Vertex Factory:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="VertexFactoryBox" Width="180" Text="LocalVertexFactory" IsEditable="True" Margin="0,0,8,0"/>
                    <TextBlock Text="Entry Point:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="EntryPointBox" Width="120" Text="Main" IsEditable="True" Margin="0,0,8,0"/>
                    <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ShaderTypeCombo" Width="60" SelectedIndex="0">
                        <ComboBoxItem Content="ps"/>
                        <ComboBoxItem Content="vs"/>
                    </ComboBox>
                    <!--<Button Content="Probe Defines" Click="ProbeDefines_Click" Padding="8,2" Margin="8,0,0,0"/>-->
                    <Button Content="Open game version" Click="OpenGameVersion_Click" Padding="8,2" Margin="4,0,0,0"/>
                    <Button Content="Open Base Shader USF" Click="OpenBaseShaderUsf_Click" Padding="8,2" Margin="4,0,0,0"/>
                    <Button Content="Open Vertex Factory USF" Click="OpenVertexFactoryUsf_Click" Padding="8,2" Margin="4,0,0,0"/>
                    <Button Content="Open Mateiral USF" Click="OpenMaterialUsf_Click" Padding="8,2" Margin="4,0,0,0"/>
                </WrapPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Include Dir:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="IncludeDirectoryBox" Margin="0,0,4,0"/>
                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="BrowseIncludeDir_Click" Padding="8,2"/>
            </Grid>
        </GroupBox>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Macros + Flags + Compile -->
            <DockPanel Grid.Column="0">
                <Button DockPanel.Dock="Bottom" Content="Compile" Click="Compile_Click"
                        Padding="8,6" FontWeight="Bold" FontSize="14" Margin="0,4,0,0"/>
                <Button DockPanel.Dock="Bottom" Content="AutoSearch" Click="Autosearch_Click"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="D3D Macros">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="Probe Hash" Click="ProbeHash_Click"
                                            Padding="8,2"/>
                                    <TextBox x:Name="ProbeHashBox" Margin="0,0,4,0" VerticalContentAlignment="Center"
                                             ToolTip="Enter target MD5 hash to probe each unchecked macro"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Add" Click="AddMacro_Click" Padding="12,2" Margin="0,0,4,0"/>
                                    <Button Content="Remove" Click="RemoveMacro_Click" Padding="12,2"/>
                                </StackPanel>
                            </StackPanel>
                            <DataGrid x:Name="MacrosGrid" AutoGenerateColumns="False"
                                      CanUserAddRows="False" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="Value" MaxWidth="50"
                                        Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Compilation Flags" Margin="0,4,0,0">
                        <WrapPanel Margin="4">
                            <CheckBox x:Name="FlagDebug" Content="Debug" Margin="0,2,8,2"/>
                            <CheckBox x:Name="FlagSkipValidation" Content="Skip Validation" Margin="0,2,8,2"/>
                            <CheckBox x:Name="FlagSkipOptimization" Content="Skip Optimization" Margin="0,2,8,2"/>
                            <CheckBox x:Name="FlagAvoidFlowControl" Content="Avoid Flow Ctrl" Margin="0,2,8,2"/>
                            <CheckBox x:Name="FlagPreferFlowControl" Content="Prefer Flow Ctrl" Margin="0,2,8,2"/>
                            <CheckBox x:Name="FlagBackwardsCompat" Content="Backwards Compat"
                                      IsChecked="True" Margin="0,2,8,2"/>
                            <CheckBox x:Name="FlagOptLevel3" Content="Optimization Lvl 3"
                                      IsChecked="True" Margin="0,2,8,2"/>
                        </WrapPanel>
                    </GroupBox>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- Right: Decompiled Shader + Expected Decompilation -->
            <GroupBox Grid.Column="2" Header="Decompiled Shader">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto" x:Name="MaterialHlslRow"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="100"/>
                        <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                        <ColumnDefinition x:Name="ExpectedColumn" Width="0" MinWidth="0"/>
                    </Grid.ColumnDefinitions>

                    <avalonEdit:TextEditor Grid.Row="0" Grid.Column="0" x:Name="DecompiledShaderEditor"
                        ShowLineNumbers="True" WordWrap="False"
                        FontFamily="Consolas" FontSize="12"
                        Background="#FF1E1E1E" Foreground="#FFDCDCDC" BorderThickness="0"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>

                    <Expander Grid.Row="2" Grid.Column="0"
                              x:Name="MaterialHlslExpander"
                              Header="Material HLSL" ExpandDirection="Up"
                              Background="#FF2D2D2D" Foreground="#FFDCDCDC"
                              BorderThickness="0,1,0,0" BorderBrush="#FF3F3F3F">
                        <avalonEdit:TextEditor x:Name="MaterialHlslEditor"
                            IsReadOnly="True"
                            ShowLineNumbers="True" WordWrap="False"
                            FontFamily="Consolas" FontSize="12"
                            Background="#FF1E1E1E" Foreground="#FFDCDCDC" BorderThickness="0"
                            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                            Height="Auto" MinHeight="100" MaxHeight="800"/>
                    </Expander>

                    <GridSplitter Grid.Row="0" Grid.Column="1" x:Name="CompareSplitter" Grid.RowSpan="3"
                        Width="5" HorizontalAlignment="Stretch" Visibility="Collapsed"
                        ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

                    <Grid Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" x:Name="ExpectedPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Background="#FF2D2D2D" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕" Click="CloseExpected_Click"
                                    Padding="6,2" Margin="2" Background="#FF5A1E1E" Foreground="White"
                                    BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                            <TextBlock Text="Expected" Foreground="#FFDCDCDC" Margin="6,3"
                                       VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
                        </DockPanel>
                        <avalonEdit:TextEditor Grid.Row="1" x:Name="ExpectedDecompiledEditor"
                            ShowLineNumbers="True" WordWrap="False"
                            FontFamily="Consolas" FontSize="12"
                            Background="#FF1E1E1E" Foreground="#FFDCDC90" BorderThickness="0"
                            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        Height="5" HorizontalAlignment="Stretch" 
                        Background="Transparent"
                        ShowsPreview="True" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                        Visibility="{Binding IsExpanded, ElementName=MaterialHlslExpander, Converter={StaticResource BooleanToVisibilityConverter}}"/>


                </Grid>
            </GroupBox>
        </Grid>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"/>

        <!-- Console -->
        <GroupBox Grid.Row="3" Header="Console" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="100"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="ConsoleOutput" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                         FontFamily="Consolas" FontSize="12"
                         Background="#FF1E1E1E" Foreground="#FFDCDCDC" BorderThickness="0"/>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="Material Info"
                               Background="#FF2D2D2D" Foreground="#FFDCDCDC"
                               FontFamily="Consolas" FontSize="11" Padding="4,2"/>
                    <TextBox x:Name="MaterialInfoOutput" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="11"
                             Background="#FF1E1E1E" Foreground="#FFDCDCDC" BorderThickness="0"/>
                </DockPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>