<Window x:Class="MilanShaderResearchTool.MacroSetFinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macro Set Finder" Height="680" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Configuration -->
        <GroupBox Grid.Row="0" Header="Configuration" Margin="0,0,0,4">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Debug Package Folder:" VerticalAlignment="Center" Margin="0,0,4,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DebugPackageFolderBox" Margin="0,0,4,4"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseFolder_Click" Padding="8,2" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Output JSON:" VerticalAlignment="Center" Margin="0,0,4,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="OutputJsonBox" Margin="0,0,4,4"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseOutput_Click" Padding="8,2" Margin="0,0,0,4"/>

                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="OnlyFailedCompilationsCheckBox" Content="Only failed compilations" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Overall progress -->
        <GroupBox Grid.Row="1" Header="Progress" Margin="0,0,0,4">
            <StackPanel Margin="4">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="OverallProgressText" DockPanel.Dock="Left" Text="Ready" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AdjustedStatsText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                    <TextBlock x:Name="MatchRateText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <TextBlock x:Name="ElapsedTimeText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
                <ProgressBar x:Name="OverallProgressBar" Height="20" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="CurrentPhaseText" Margin="0,4,0,0" FontStyle="Italic" Foreground="Gray"/>
            </StackPanel>
        </GroupBox>

        <!-- Summary -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock x:Name="SummaryText" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
            <Button x:Name="StartButton" Content="Start Search" Click="Start_Click" Padding="12,6" FontWeight="Bold" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Padding="12,6" IsEnabled="False"/>
        </StackPanel>

        <!-- Results grid -->
        <DataGrid Grid.Row="4" x:Name="ResultsGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  FontFamily="Consolas" FontSize="12"
                  MouseDoubleClick="ResultsGrid_MouseDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open in Research Tool" Click="OpenInResearchTool_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Vertex Factory" Binding="{Binding VertexFactoryName}" Width="160"/>
                <DataGridTextColumn Header="Shader Type" Binding="{Binding ShaderTypeName}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Phase" Binding="{Binding SearchPhase}" Width="140"/>
                <DataGridTextColumn Header="Macros" Binding="{Binding Macros.Count}" Width="60"/>
                <DataGridTextColumn Header="Time (s)" Binding="{Binding ElapsedSeconds, StringFormat=F1}" Width="70"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Found}" Value="True">
                            <Setter Property="Background" Value="#FF1E4D1E"/>
                            <Setter Property="Foreground" Value="#FF90EE90"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Found}" Value="False">
                            <Setter Property="Background" Value="#FF4D1E1E"/>
                            <Setter Property="Foreground" Value="#FFFF9999"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Log -->
        <TextBox Grid.Row="5" x:Name="LogBox" Height="120" Margin="0,4,0,0"
                 IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                 TextWrapping="NoWrap" AcceptsReturn="True"/>
    </Grid>
</Window>
