<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <!-- LegendaryExplorerCore only compiles its registry-based game lookup under these. -->
    <Configurations>WinDebug;WinRelease</Configurations>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProjectMilanCore\ProjectMilanCore.csproj" />
    <ProjectReference Include="..\ProjectMilan_ExtraContent\ProjectMilan_ExtraContent.csproj" />
  </ItemGroup>

</Project>
