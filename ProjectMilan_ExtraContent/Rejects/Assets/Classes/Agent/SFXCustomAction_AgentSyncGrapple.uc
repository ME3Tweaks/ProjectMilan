Class SFXCustomAction_AgentSyncGrapple extends SFXCustomAction_VariableExit
    config(Game);

public event function ReachedPrecisePosition()
{
    ApplyTimeline(TimelineTemplate, m_oPawn, SyncPartner);
    LoopState = ECustomActionLoopState.LoopState_Start;
    m_oPawn.PlayBodyStance(BS_InstigatorStart, InstigatorPlayRate, InstigatorBlendInTime, 0.0);
    m_oPawn.SetBodyStanceAnimEndNotification(BS_InstigatorStart, TRUE);
    m_oPawn.Mesh.RootMotionMode = ERootMotionMode.RMM_Translate;
    m_oPawn.SetBodyStanceRootBoneAxisOption(BS_InstigatorStart, 2, 2, 2);
    SyncPartner.SetTimer(FMax(0.00100000005, VictimAnimDelay), FALSE, 'StartVictimAnim', Self);
    m_oPawn.ClearTimer('InteractionStartTimedOut', Self);
}
public function StartInteraction()
{
    local BioPlayerController PC;
    
    if (SyncPartner != None)
    {
        if (m_oPawn != None)
        {
            PC = BioPlayerController(SyncPartner.Controller);
            if (PC != None && PC.IsLocalPlayerController())
            {
                PC.HintSystem.HintEvent('Damaged', 'SFXDamageType_SyncMelee');
            }
        }
    }
    MoveToMarkers();
    m_oPawn.SetTimer(InteractionStartTimeOut, FALSE, 'InteractionStartTimedOut', Self);
}
public function Teleport()
{
    local Vector X;
    local Vector Y;
    local Vector Z;
    local Vector TeleportLoc;
    local Vector DestinationLoc;
    local NavigationPoint N;
    local NavigationPoint BestNav;
    local float Distance;
    local float BestDistance;
    
    GetAxes(m_oPawn.Rotation, X, Y, Z);
    if (FRand() > 0.5)
    {
        DestinationLoc = m_oPawn.location + X * -1450.0 + Y * -50.0;
    }
    else
    {
        DestinationLoc = m_oPawn.location + X * -1450.0 + Y * -50.0;
    }
    if (m_oPawn.FindNearestOpenLocation(DestinationLoc, TeleportLoc))
    {
        foreach m_oPawn.WorldInfo.RadiusNavigationPoints(Class'NavigationPoint', N, DestinationLoc, 500.0)
        {
            if (N != None && N.IsUsableAnchorFor(m_oPawn))
            {
                Distance = VSize(N.location - TeleportLoc);
                if (BestNav == None || Distance < BestDistance)
                {
                    BestDistance = Distance;
                    BestNav = N;
                }
            }
        }
        if (BestNav != None)
        {
            m_oPawn.SetLocation(BestNav.location, );
            m_oAI.MoveTarget = None;
        }
    }
    EndThisCustomAction();
}
public function bool MessageEvent(Name EventName, Object Sender)
{
    local BioPlayerController PC;
    
    if (EventName == 'MashSuccess')
    {
        if (m_oPawn != None)
        {
            if (SyncPartner != None)
            {
                PC = BioPlayerController(SyncPartner.Controller);
                if (PC != None && PC.IsLocalPlayerController())
                {
                    PC.HintSystem.HintEvent('BrokeMelee');
                }
            }
        }
    }
    return Super.MessageEvent(EventName, Sender);
}
public function StopCustomAction()
{
    local SFXAI_Agent AgentAI;
    
    Super.StopCustomAction();
    AgentAI = SFXAI_Agent(m_oAI);
    if (AgentAI != None)
    {
        AgentAI.bIsAttemptingSyncAttack = false;
        AgentAI.LastSyncMeleeTime = AgentAI.WorldInfo.GameTimeSeconds;
    }
}

