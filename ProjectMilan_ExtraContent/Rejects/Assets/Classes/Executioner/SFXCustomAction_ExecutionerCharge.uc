Class SFXCustomAction_ExecutionerCharge extends SFXCustomAction_SingleAnim
    config(Game);

var(AnimControl) SFXAnimSetCookSpec AnimInfo;
var Actor TeleportLocation;
var ParticleSystem PS_TeleportOut;
var ParticleSystem PS_TeleportIn;
var float NavPointSearchRange;
var float NavPointMinRange;
var float AcceptablePlayerArc;

public static function PrecacheVFX(SFXObjectPool ObjectPool, RvrClientEffectManager ClientEffects)
{
    Super(BioCustomAction).PrecacheVFX(ObjectPool, ClientEffects);
    ObjectPool.PrecacheImpactEmitter(default.PS_TeleportOut);
    ObjectPool.PrecacheGenericParticleSystemComponent(default.PS_TeleportIn);
}
public function StartCustomAction()
{
    local SFXAI_Executioner ExecutionerAI;
    
    ExecutionerAI = SFXAI_Executioner(m_oAI);
    if (ExecutionerAI != None)
    {
        TeleportLocation = ExecutionerAI.TeleportLocation;
        ExecutionerAI.LastTeleportTime = ExecutionerAI.WorldInfo.GameTimeSeconds;
    }
    if (TeleportLocation == None)
    {
        return;
    }
    if (m_oPawn != None && AnimInfo != None)
    {
        m_oPawn.RegisterTemporaryAnim(AnimInfo.AnimSet);
    }
    m_oPawn.SetDesiredRotation(Rotator(Normal(TeleportLocation.location - m_oPawn.location)), TRUE, TRUE, 1.0);
    Super.StartCustomAction();
}
public function StopCustomAction()
{
    Super.StopCustomAction();
    if (AnimInfo != None)
    {
        m_oPawn.UnregisterTemporaryAnim(AnimInfo.AnimSet);
    }
}
public function StartTeleport()
{
    local SFXEmitter TeleportOut;
    
    TeleportOut = SFXGRI(m_oPawn.WorldInfo.GRI).ObjectPool.GetImpactEmitter(PS_TeleportOut, m_oPawn.location, m_oPawn.Rotation);
    if (TeleportOut != None)
    {
        TeleportOut.SetLifetime(2.0);
        TeleportOut.ParticleSystemComponent.SetScale(0.25);
        TeleportOut.ParticleSystemComponent.SetActive(TRUE);
    }
}
public function GetNearestNavPointLocation(Vector TargetLocation, out Vector NewLocation)
{
    local NavigationPoint ChkPoint;
    local NavigationPoint BestNav;
    local float Distance;
    local float BestDistance;
    
    foreach m_oPawn.WorldInfo.RadiusNavigationPoints(Class'NavigationPoint', ChkPoint, TargetLocation, NavPointSearchRange)
    {
        if (ChkPoint != None && ChkPoint.IsUsableAnchorFor(m_oPawn))
        {
            if (Normal(ChkPoint.location - TeleportLocation.location) Dot Vector(TeleportLocation.Rotation) < AcceptablePlayerArc)
            {
                continue;
            }
            Distance = VSize(ChkPoint.location - TargetLocation);
            if (Distance >= NavPointMinRange)
            {
                if (BestNav == None || Distance < BestDistance)
                {
                    BestDistance = Distance;
                    BestNav = ChkPoint;
                }
            }
        }
    }
    NewLocation = BestNav.location;
}
public function TeleportExecutioner()
{
    local Vector NearestTeleportLoc;
    local bool bSetLocationSuccess;
    local SFXAI_Executioner ExecutionerAI;
    
    GetNearestNavPointLocation(TeleportLocation.location, NearestTeleportLoc);
    bSetLocationSuccess = m_oPawn.SetLocation(NearestTeleportLoc, );
    SFXGRI(m_oPawn.WorldInfo.GRI).DuringAsyncWorker.SpawnEffectAtLocation(m_oPawn, PS_TeleportIn, m_oPawn.location + Normal(Vector(m_oPawn.Rotation)) * 50.0, m_oPawn.Rotation);
    ExecutionerAI = SFXAI_Executioner(m_oAI);
    if (ExecutionerAI != None && ExecutionerAI.WorldInfo != None)
    {
        if (bSetLocationSuccess == TRUE && ExecutionerAI.bRushChargingActive == TRUE)
        {
            ExecutionerAI.ChargeCountThisRush++;
        }
    }
}

